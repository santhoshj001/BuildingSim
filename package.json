{
  "name": "aiot-simulator",
  "version": "1.0.0",
  "description": "AIoT Building Simulator with Shelly 1PM Gen 4 devices",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server/index.js",
    "db:push": "prisma db push",
    "db:seed": "node server/seed.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@prisma/client": "^5.7.0",
    "aedes": "^0.50.0",
    "antd": "^5.12.8",
    "axios": "^1.6.3",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "express": "^4.18.2",
    "mqtt": "^5.3.4",
    "next": "14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.1",
    "socket.io": "^4.6.0",
    "socket.io-client": "^4.6.0",
    "uuid": "^9.0.1",
    "websocket-stream": "^5.5.2",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
}
